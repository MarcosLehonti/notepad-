# Configuración de Google Gemini API
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini a utilizar (opcional, por defecto gemini-3.5-flash-lite)
# Opciones: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
